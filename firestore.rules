rules_version = '2';

// UpperCrust One: Firestore security rules.
// Keep the staff list in step with STAFF in one/js/config.js and with the users created in Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    function listed() {
      return request.auth != null && request.auth.token.email in [
        'manojrohit@uppercrustwealth.com',
        'roshanshah@uppercrustwealth.com',
        'hemantpatel@uppercrustwealth.com',
        'savan@uppercrustwealth.com',
        'palakshah@uppercrustwealth.com',
        'harshil_patel@uppercrustwealth.com',
        'navin@uppercrustwealth.com',
        'kanchanbhagwat@uppercrustwealth.com',
        'omkar@uppercrustwealth.com',
        'prakashpatel@uppercrustwealth.com',
        'ops@uppercrustwealth.com',
        'sudheerkumar@uppercrustwealth.com',
        'sandeep@uppercrustwealth.com',
        'yuvraj@uppercrustwealth.com',
        'equity@uppercrustwealth.com',
        'crm@uppercrustwealth.com',
        'ishagil@uppercrustwealth.com',
        'bijalmehta@uppercrustwealth.com',
        'aasthapanwar@uppercrustwealth.com',
        'happy@uppercrustwealth.com',
        'dhruvpawashe@uppercrustwealth.com',
        'admin@uppercrustwealth.com',
        'admin@uppercrustwealth.com'
      ];
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@uppercrustwealth.com';
    }

    // Each learner's progress. Document id = their Firebase user id. Only that person (and the admin) can read it.
    match /learners/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v','name','mobile','kind','onb','lang','start','done','part','q','quiz','creds','lab','act','streak','last','created','updated','email'])
        && request.resource.data.email == request.auth.token.email.lower();
      allow delete: if isAdmin();
    }

    // Employee leaderboard: staff read each other's scores, each person writes only their own.
    match /board/{uid} {
      allow read: if listed();
      allow create, update: if listed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','xp','wk','streak','lessons','updated'])
        && request.resource.data.email == request.auth.token.email.lower();
      allow delete: if isAdmin();
    }

    // Fund library data the admin maintains: extra funds and each month's portfolio holdings. Any signed-in learner can read.
    match /fundx/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /fundmonths/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Credentials: anyone with the link (the id is unguessable) can read ONE credential to verify it. Nobody can list them except the admin.
    match /credentials/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin()) && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }
  }
}
