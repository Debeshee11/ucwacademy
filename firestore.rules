rules_version = '2';

// UpperCrust Academy + UpperCrust One — Firestore security rules.
// Only the people on the list below can read anything. Each RM writes only their own progress,
// and only the admin can publish news, lessons, fund notes, index data, settings and translations.
// Keep the email list in step with ACCOUNTS in index.html and with the users created in Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    function listed() {
      return request.auth != null && request.auth.token.email in [
        'manojrohit@uppercrustwealth.com',
        'roshanshah@uppercrustwealth.com',
        'hemantpatel@uppercrustwealth.com',
        'savan@uppercrustwealth.com',
        'palakshah@uppercrustwealth.com',
        'harshil_patel@uppercrustwealth.com',
        'navin@uppercrustwealth.com',
        'kanchanbhagwat@uppercrustwealth.com',
        'omkar@uppercrustwealth.com',
        'prakashpatel@uppercrustwealth.com',
        'ops@uppercrustwealth.com',
        'sudheerkumar@uppercrustwealth.com',
        'sandeep@uppercrustwealth.com',
        'yuvraj@uppercrustwealth.com',
        'equity@uppercrustwealth.com',
        'crm@uppercrustwealth.com',
        'ishagil@uppercrustwealth.com',
        'bijalmehta@uppercrustwealth.com',
        'aasthapanwar@uppercrustwealth.com',
        'happy@uppercrustwealth.com',
        'dhruvpawashe@uppercrustwealth.com',
        'admin@uppercrustwealth.com'
      ];
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@uppercrustwealth.com';
    }

    // Each RM's learning progress (document id = their Firebase user id). The admin can also edit any record.
    match /players/{uid} {
      allow read: if listed();
      allow create, update: if listed() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Private per-RM records (client profiles). Only that RM can read or write them.
    match /data/users/{uid}/{doc} {
      allow read, write: if listed() && request.auth.uid == uid;
    }

    // Shared content: everyone on the list reads, only the admin changes it.
    match /news/{id}    { allow read: if listed(); allow write: if isAdmin(); }
    match /lessons/{id} { allow read: if listed(); allow write: if isAdmin(); }
    match /funds/{id}   { allow read: if listed(); allow write: if isAdmin(); }
    match /indices/{id} { allow read: if listed(); allow write: if isAdmin(); }
    match /config/{id}  { allow read: if listed(); allow write: if isAdmin(); }
    match /i18n/{id}    { allow read: if listed(); allow write: if isAdmin(); }

    // ——— UpperCrust One ———
    // Each learner's progress. Document id = their Firebase user id. Only that person (and the admin) can read it.
    match /learners/{uid} {
      allow read: if isAdmin() || (listed() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if listed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v','name','lang','start','done','part','q','quiz','creds','lab','act','streak','last','created','updated','email'])
        && request.resource.data.email == request.auth.token.email.lower();
      allow delete: if isAdmin();
    }

    // Credentials: anyone with the link (the id is unguessable) can read ONE credential to verify it. Nobody can list them except the admin.
    match /credentials/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if listed() && request.resource.data.uid == request.auth.uid;
      allow update: if listed() && (resource.data.uid == request.auth.uid || isAdmin()) && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
    }
  }
}
